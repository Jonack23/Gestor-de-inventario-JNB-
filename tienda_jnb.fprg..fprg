<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Tienda JNB"/>
        <attribute name="authors" value="Nathali, Brandon, Jonathan"/>
        <attribute name="about" value="Sistema de Inventario y Ventas Tienda JNB"/>
        <attribute name="saved" value="2026-11-24 10:58:29 a.&#160;m."/>
        <attribute name="created" value="SmFpbWU7Sk9OQUNLUy1MQVBUT1A7MjAyNi0xMS0yNDswOTo0MTo1MiBhLsKgbS47MzEwMA=="/>
        <attribute name="edited" value="SmFpbWU7Sk9OQUNLUy1MQVBUT1A7MjAyNi0xMS0yNDsxMDo1ODoyOSBhLsKgbS47MjszMjEz"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="usuariosNombre" type="String" array="True" size="3"/>
            <declare name="usuariosPass" type="String" array="True" size="3"/>
            <declare name="usuariosRol" type="String" array="True" size="3"/>
            <declare name="totalUsuarios" type="Integer" array="False" size=""/>
            <assign variable="totalUsuarios" expression="3"/>
            <assign variable="usuariosNombre[0]" expression="&quot;Jona.admin&quot;"/>
            <assign variable="usuariosPass[0]" expression="&quot;Jonack123&quot;"/>
            <assign variable="usuariosRol[0]" expression="&quot;jefe&quot;"/>
            <assign variable="usuariosNombre[1]" expression="&quot;Brandon.0&quot;"/>
            <assign variable="usuariosPass[1]" expression="&quot;Brandonx0&quot;"/>
            <assign variable="usuariosRol[1]" expression="&quot;empleado&quot;"/>
            <assign variable="usuariosNombre[2]" expression="&quot;Natali.00&quot;"/>
            <assign variable="usuariosPass[2]" expression="&quot;Natali000&quot;"/>
            <assign variable="usuariosRol[2]" expression="&quot;empleado&quot;"/>
            <declare name="prodNombre" type="String" array="True" size="14"/>
            <declare name="prodClasificacion" type="String" array="True" size="14"/>
            <declare name="prodCantidad" type="Integer" array="True" size="14"/>
            <declare name="prodPrecio" type="Real" array="True" size="14"/>
            <declare name="prodVendidos" type="Integer" array="True" size="14"/>
            <declare name="totalProductos" type="Integer" array="False" size=""/>
            <declare name="totalCaja" type="Real" array="False" size=""/>
            <declare name="totalVentas" type="Integer" array="False" size=""/>
            <assign variable="totalCaja" expression="0"/>
            <assign variable="totalVentas" expression="0"/>
            <assign variable="totalProductos" expression="cargarInventarioInicial(prodNombre, prodClasificacion, prodCantidad, prodPrecio, prodVendidos)"/>
            <declare name="programaActivo" type="Integer" array="False" size=""/>
            <assign variable="programaActivo" expression="1"/>
            <declare name="posUsuario" type="Integer" array="False" size=""/>
            <declare name="usuarioActivo" type="String" array="False" size=""/>
            <declare name="rolActivo" type="String" array="False" size=""/>
            <declare name="opcion" type="Integer" array="False" size=""/>
            <while expression="programaActivo == 1">
                <assign variable="posUsuario" expression="iniciarSesion(usuariosNombre, usuariosPass, usuariosRol, totalUsuarios)"/>
                <if expression="posUsuario == -1">
                    <then>
                        <assign variable="programaActivo" expression="0"/>
                    </then>
                    <else>
                        <assign variable="usuarioActivo" expression="usuariosNombre[posUsuario]"/>
                        <assign variable="rolActivo" expression="usuariosRol[posUsuario]"/>
                        <do expression="opcion != 0 &amp;&amp; opcion != 7">
                            <output expression="&quot;===== TIENDA JNB | Usuario: &quot; &amp; usuarioActivo &amp; &quot; (&quot; &amp; rolActivo &amp; &quot;) =====&quot;" newline="True"/>
                            <if expression="rolActivo == &quot;jefe&quot;">
                                <then>
                                    <output expression="&quot;1. Registrar producto&quot;" newline="True"/>
                                </then>
                                <else/>
                            </if>
                            <output expression="&quot;2. Listar inventario | 3. Buscar | 4. Filtrar | 5. Venta&quot;" newline="True"/>
                            <if expression="rolActivo == &quot;jefe&quot;">
                                <then>
                                    <output expression="&quot;6. Reporte de resultados&quot;" newline="True"/>
                                </then>
                                <else/>
                            </if>
                            <output expression="&quot;7. Cerrar sesion | 8. Ayuda | 9. Integrantes | 0. Salir&quot;" newline="True"/>
                            <input variable="opcion"/>
                            <while expression="opcion &lt; 0 || opcion &gt; 9">
                                <output expression="&quot;Opcion no valida. Escriba un numero de 0 a 9:&quot;" newline="True"/>
                                <input variable="opcion"/>
                            </while>
                            <if expression="opcion == 1">
                                <then>
                                    <if expression="rolActivo == &quot;jefe&quot;">
                                        <then>
                                            <assign variable="totalProductos" expression="registrarProducto(prodNombre, prodClasificacion, prodCantidad, prodPrecio, prodVendidos, totalProductos)"/>
                                        </then>
                                        <else>
                                            <output expression="&quot;Acceso denegado: solo el jefe puede registrar productos.&quot;" newline="True"/>
                                        </else>
                                    </if>
                                </then>
                                <else>
                                    <if expression="opcion == 2">
                                        <then>
                                            <call expression="listarInventario(prodNombre, prodClasificacion, prodCantidad, prodPrecio, totalProductos)"/>
                                        </then>
                                        <else>
                                            <if expression="opcion == 3">
                                                <then>
                                                    <call expression="buscarPorNombre(prodNombre, prodClasificacion, prodCantidad, prodPrecio, totalProductos)"/>
                                                </then>
                                                <else>
                                                    <if expression="opcion == 4">
                                                        <then>
                                                            <call expression="filtrarPorClasificacion(prodNombre, prodClasificacion, prodCantidad, prodPrecio, totalProductos)"/>
                                                        </then>
                                                        <else>
                                                            <if expression="opcion == 5">
                                                                <then>
                                                                    <assign variable="totalCaja" expression="realizarVenta(prodNombre, prodCantidad, prodPrecio, prodVendidos, totalProductos, totalCaja)"/>
                                                                </then>
                                                                <else>
                                                                    <if expression="opcion == 6">
                                                                        <then>
                                                                            <if expression="rolActivo == &quot;jefe&quot;">
                                                                                <then>
                                                                                    <call expression="generarReporte(prodNombre, prodCantidad, prodPrecio, prodVendidos, totalProductos, totalCaja)"/>
                                                                                </then>
                                                                                <else>
                                                                                    <output expression="&quot;Acceso denegado: solo el jefe puede ver reportes.&quot;" newline="True"/>
                                                                                </else>
                                                                            </if>
                                                                        </then>
                                                                        <else>
                                                                            <if expression="opcion == 7">
                                                                                <then>
                                                                                    <output expression="&quot;Cerrando sesion...&quot;" newline="True"/>
                                                                                </then>
                                                                                <else>
                                                                                    <if expression="opcion == 8">
                                                                                        <then>
                                                                                            <call expression="mostrarAyuda()"/>
                                                                                        </then>
                                                                                        <else>
                                                                                            <if expression="opcion == 9">
                                                                                                <then>
                                                                                                    <call expression="mostrarIntegrantes()"/>
                                                                                                </then>
                                                                                                <else>
                                                                                                    <output expression="&quot;Saliendo del sistema...&quot;" newline="True"/>
                                                                                                    <assign variable="programaActivo" expression="0"/>
                                                                                                </else>
                                                                                            </if>
                                                                                        </else>
                                                                                    </if>
                                                                                </else>
                                                                            </if>
                                                                        </else>
                                                                    </if>
                                                                </else>
                                                            </if>
                                                        </else>
                                                    </if>
                                                </else>
                                            </if>
                                        </else>
                                    </if>
                                </else>
                            </if>
                        </do>
                    </else>
                </if>
            </while>
        </body>
    </function>
    <function name="buscarPorNombre" type="None" variable="">
        <parameters>
            <parameter name="prodNombre" type="String" array="True"/>
            <parameter name="prodClasificacion" type="String" array="True"/>
            <parameter name="prodCantidad" type="Integer" array="True"/>
            <parameter name="prodPrecio" type="Real" array="True"/>
            <parameter name="totalProductos" type="Integer" array="False"/>
        </parameters>
        <body>
            <declare name="buscado" type="String" array="False" size=""/>
            <declare name="encontrado" type="Integer" array="False" size=""/>
            <declare name="i" type="Integer" array="False" size=""/>
            <output expression="&quot;Ingrese el nombre del producto a buscar:&quot;" newline="True"/>
            <input variable="buscado"/>
            <assign variable="encontrado" expression="0"/>
            <for variable="i" start="0" end="totalProductos - 1" direction="inc" step="1">
                <if expression="prodNombre[i] == buscado">
                    <then>
                        <output expression="(i + 1) &amp; &quot; | &quot; &amp; prodNombre[i] &amp; &quot; | &quot; &amp; prodClasificacion[i] &amp; &quot; | Stock: &quot; &amp; prodCantidad[i] &amp; &quot; | $&quot; &amp; prodPrecio[i]" newline="True"/>
                        <assign variable="encontrado" expression="1"/>
                    </then>
                    <else/>
                </if>
            </for>
            <if expression="encontrado == 0">
                <then>
                    <output expression="&quot;Producto no encontrado.&quot;" newline="True"/>
                </then>
                <else/>
            </if>
        </body>
    </function>
